{
	"schemaVersion": 1,
	"id": "mineeverything",
	"version": "${version}",
	"name": "Mine (Almost) Everything",
	"description": "Lets a netherite pickaxe mine blocks that are normally unbreakable, like bedrock (including the bottom layer of the Overworld) and reinforced deepslate. Takes 2 minutes, sped up by Efficiency and Haste, and the block drops as itself.",
	"authors": [
		"seigmannen"
	],
	"contact": {
		"homepage": "https://github.com/Seigmannen/bedrock-miner",
		"sources": "https://github.com/Seigmannen/bedrock-miner"
	},
	"license": "MIT",
	"icon": "assets/mineeverything/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.seigmannen.mineeverything.MineEverything"
		],
		"client": [
			"com.seigmannen.mineeverything.client.MineEverythingClient"
		]
	},
	"mixins": [
		"mineeverything.mixins.json",
		{
			"config": "mineeverything.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}