{
	"schemaVersion": 1,
	"id": "mineeverything",
	"version": "${version}",
	"name": "Mine (Almost) Everything",
	"description": "Lets a netherite pickaxe mine blocks that are normally unbreakable, like bedrock and reinforced deepslate, and lets Silk Touch on an iron pickaxe or better mine budding amethyst and spawners. Each part can be turned on or off per world with /mae.",
	"authors": [
		"Seigmannen"
	],
	"contact": {
		"homepage": "https://github.com/Seigmannen/MineAlmostEverything",
		"sources": "https://github.com/Seigmannen/MineAlmostEverything",
		"issues": "https://github.com/Seigmannen/MineAlmostEverything/issues"
	},
	"license": "MIT",
	"icon": "assets/mineeverything/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.seigmannen.mineeverything.MineEverything"
		],
		"client": [
			"com.seigmannen.mineeverything.client.MineEverythingClient"
		]
	},
	"mixins": [
		"mineeverything.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.162.0"
	}
}
